{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://doppelganger.invalid/schemas/autopsy-report.schema.json",
  "title": "AutopsyReport",
  "description": "Per-window scores, state timeline and verdict for one analyzed file (autopsy-mode). Numbers only: no samples, no file name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelId",
    "modelVersion",
    "durationS",
    "windows",
    "states",
    "verdict",
    "verdictReason"
  ],
  "properties": {
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "modelVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "durationS": {
      "type": "number",
      "minimum": 0
    },
    "windows": {
      "type": "array",
      "items": {
        "title": "AutopsyWindow",
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "startS", "endS", "voiced", "score", "smoothed"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "startS": {
            "type": "number",
            "minimum": 0
          },
          "endS": {
            "type": "number",
            "minimum": 0
          },
          "voiced": {
            "type": "boolean"
          },
          "score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "smoothed": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "title": "AutopsySegment",
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "state"],
        "properties": {
          "from": {
            "type": "number",
            "minimum": 0
          },
          "to": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": ["idle", "listening", "mask", "unease", "possession", "exorcised"]
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["likely-human", "inconclusive", "likely-synthetic"]
    },
    "verdictReason": {
      "type": "string",
      "enum": [
        "Not enough speech",
        "Dissonance reached Possession",
        "Dissonance rose to Unease but never reached Possession",
        "Dissonance stayed low"
      ]
    }
  }
}
