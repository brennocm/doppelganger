{
  "$description": "Design tokens from .kiro/steering/design-system.md. Source of truth: run `pnpm --filter @doppelganger/tokens run build` to regenerate generated/.",
  "color": {
    "bg-top": "#1E1826",
    "bg": "#131116",
    "bg-deep": "#0A090B",
    "bg-glow": "#0E1017",
    "surface-button": "#131313",
    "surface-input": "#1F1B23",
    "surface-sidebar": "#211D25",
    "surface-control": "#28242E",
    "surface-chip": "#352F3D",
    "surface-avatar": "#413C49",
    "text": "#FFFFFF",
    "text-secondary": "#DCDADF",
    "text-body": "#B7B5BC",
    "text-muted": "#938F9B",
    "text-subtle": "#716D75",
    "text-placeholder": "#8C8794",
    "line-strong": "#6E6975",
    "purple": "#B07FFF",
    "on-purple": "#131116",
    "purple-deep": "#432A6B",
    "purple-ink": "#2A0A55",
    "purple-line": "#7B5CB8",
    "info-surface": "#151721",
    "info-line": "#356AC3",
    "info-chip": "#285092",
    "info-chip-text": "#AECDF5",
    "ember": "#FFA552",
    "ember-deep": "#4A2A12",
    "blood": "#FF5468",
    "blood-deep": "#3A0E16",
    "ecto": "#9CF27A",
    "on-ecto": "#131116"
  },
  "font": {
    "ui": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
  },
  "type": {
    "hero": {
      "size": "clamp(36px, 6vw, 60px)",
      "line": "1.06",
      "weight": 600,
      "family": "ui"
    },
    "display": {
      "size": "26px",
      "line": "32px",
      "weight": 600,
      "family": "ui"
    },
    "title": {
      "size": "14px",
      "line": "20px",
      "weight": 600,
      "family": "ui"
    },
    "body": {
      "size": "13px",
      "line": "20px",
      "weight": 400,
      "family": "ui"
    },
    "reading": {
      "size": "16px",
      "line": "24px",
      "weight": 400,
      "family": "ui"
    },
    "label": {
      "size": "13px",
      "line": "16px",
      "weight": 500,
      "family": "ui"
    },
    "small": {
      "size": "12px",
      "line": "16px",
      "weight": 500,
      "family": "ui"
    },
    "legal": {
      "size": "10px",
      "line": "15px",
      "weight": 400,
      "family": "ui"
    },
    "chip-mono": {
      "size": "12px",
      "line": "16px",
      "weight": 500,
      "family": "mono"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "full": "9999px"
  },
  "motion": {
    "duration-ui": "200ms",
    "duration-turn": "300ms",
    "duration-tint": "400ms",
    "ease-ui": "cubic-bezier(0.23, 1, 0.32, 1)"
  },
  "focus": {
    "width": "2px",
    "offset": "2px"
  }
}
